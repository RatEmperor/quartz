		{"id":"d0b2663764006805","type":"text","text":"","x":860,"y":843,"width":220,"height":79,"color":"5"},
		{"id":"d0dfe4cb30432d37","type":"text","text":"Placatka","x":-940,"y":1607,"width":183,"height":50,"color":"1"},
		{"id":"579f0b6229e3602c","type":"text","text":"","x":-600,"y":1280,"width":560,"height":177},
