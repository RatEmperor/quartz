		{"id":"534fac3f40651f6f","type":"text","text":"","x":80,"y":1643,"width":720,"height":79},
		{"id":"147d54d181de7da9","type":"text","text":"","x":80,"y":1378,"width":720,"height":79},
		{"id":"bb74d95723df6d28","type":"text","text":"","x":80,"y":1901,"width":720,"height":79},
		{"id":"bf1713cd2df0662e","type":"text","text":"","x":80,"y":1803,"width":720,"height":79},
		{"id":"f5cebec0ba8aeed6","type":"text","text":"Placatka může mít až *4 Charge*, jejich počet se odvíjí od kvality nápoje v ní. Pokud se z ní někdo napije, obdrží náhodně jeden z následujících bonusů:\n1-2 *-1 Stress*\n3-4- *-1 Condition*\n5- *+1 Fortune*\n6- *+1 Resolve*\n7- *Fearless (Everything)*\n8- *Poisoned*\n","x":-1080,"y":1721,"width":323,"height":242,"color":"3"},
		{"id":"33ea948ad533e191","type":"text","text":"","x":860,"y":1378,"width":220,"height":79,"color":"5"},
		{"id":"cd5bae8680845c5d","type":"text","text":"","x":860,"y":1544,"width":220,"height":79,"color":"5"},
